{
  "schema": "binario-shared-data-v1",
  "description": "The rail notice feeds and the tables that read them, the same on Android and on the iPhone: each feed's address, gate (every build or only with the personal live sources), limits, rate, cache and redirect rule, the pages opened on a tap, and the limits, words and patterns of the readers. The patterns are the ones Kotlin compiles; the iPhone compiles them with NSRegularExpression (contracts/shared-rules/v1/notices-v1.json holds the cases both read). How every source is asked (User-Agent, refusals, breaker) is source-manners-v1.json.",
  "service": {
    "sourceTimeoutSeconds": 20,
    "reloadAfterSeconds": 120
  },
  "sources": [
    {
      "id": "mit-strikes-rss",
      "publisher": null,
      "gate": "all-builds",
      "url": "https://scioperi.mit.gov.it/mit2/public/scioperi/rss",
      "accept": "application/rss+xml, application/xml, text/xml",
      "connectTimeoutSeconds": 8,
      "readTimeoutSeconds": 12,
      "totalTimeoutSeconds": 20,
      "maximumBytes": 1048576,
      "maximumRequests": 3,
      "redirects": "same-https-host",
      "viaggiaTrenoCleartextHop": false,
      "minimumIntervalSeconds": 1800,
      "timeToLiveSeconds": 21600,
      "maximumStaleSeconds": 86400,
      "retryDelayMillis": 750,
      "pauseLabel": null
    },
    {
      "id": "rfi-infomobility-rss",
      "publisher": "RFI",
      "gate": "all-builds",
      "url": "https://www.rfi.it/content/rfi/it/news-e-media/infomobilita.rss.updates.xml",
      "accept": "application/rss+xml, application/xml, text/xml",
      "connectTimeoutSeconds": 12,
      "readTimeoutSeconds": 20,
      "totalTimeoutSeconds": 25,
      "maximumBytes": 2097152,
      "maximumRequests": 3,
      "redirects": "same-resource",
      "viaggiaTrenoCleartextHop": false,
      "minimumIntervalSeconds": 300,
      "timeToLiveSeconds": 600,
      "maximumStaleSeconds": 3600,
      "retryDelayMillis": null,
      "pauseLabel": null
    },
    {
      "id": "trenitalia-infomobility-news",
      "publisher": "TRENITALIA",
      "gate": "personal",
      "url": "https://www.viaggiatreno.it/infomobilitamobile/resteasy/news/infomobility",
      "accept": "application/json",
      "connectTimeoutSeconds": 8,
      "readTimeoutSeconds": 12,
      "totalTimeoutSeconds": 15,
      "maximumBytes": 2097152,
      "maximumRequests": 3,
      "redirects": "same-resource",
      "viaggiaTrenoCleartextHop": true,
      "minimumIntervalSeconds": 300,
      "timeToLiveSeconds": 600,
      "maximumStaleSeconds": 3600,
      "retryDelayMillis": 750,
      "pauseLabel": "ViaggiaTreno"
    },
    {
      "id": "viaggiatreno-train-notices",
      "publisher": "TRENITALIA",
      "gate": "personal",
      "url": "https://www.viaggiatreno.it/infomobilitamobile/resteasy/news/smartcaring",
      "accept": "application/json",
      "connectTimeoutSeconds": 8,
      "readTimeoutSeconds": 12,
      "totalTimeoutSeconds": 15,
      "maximumBytes": 2097152,
      "maximumRequests": 3,
      "redirects": "same-resource",
      "viaggiaTrenoCleartextHop": true,
      "minimumIntervalSeconds": 30,
      "timeToLiveSeconds": 300,
      "maximumStaleSeconds": 1800,
      "retryDelayMillis": 750,
      "pauseLabel": "ViaggiaTreno"
    },
    {
      "id": "trenord-line-notices",
      "publisher": "TRENORD",
      "gate": "personal",
      "url": "https://www.trenord.it/mgmt/store-management-api/mia/direttrici/",
      "accept": "application/json",
      "connectTimeoutSeconds": 8,
      "readTimeoutSeconds": 12,
      "totalTimeoutSeconds": 15,
      "maximumBytes": 1048576,
      "maximumRequests": 3,
      "redirects": "same-resource",
      "viaggiaTrenoCleartextHop": false,
      "minimumIntervalSeconds": 600,
      "timeToLiveSeconds": 900,
      "maximumStaleSeconds": 7200,
      "retryDelayMillis": 750,
      "pauseLabel": null
