  "links": {
    "mitStrikeCalendar": "https://scioperi.mit.gov.it/mit2/public/scioperi",
    "fsNews": "https://www.fsnews.it/",
    "guaranteedTrains": {
      "TRENITALIA": "https://www.trenitalia.com/it/informazioni/treni-garantiti-incasodisciopero.html",
      "TRENORD": "https://www.trenord.it/en/assistance/useful-information/in-case-of-strike-action/"
    }
  },
  "text": {
    "maximumInput": 200000,
    "noticeTitleLength": 300,
    "noticeBodyLength": 6000,
    "strikeWordPattern": "\\bscioper[oi]\\b",
    "urlPattern": "https?://[^\\s<>\"'\\u00A0]+",
    "urlTrailing": ".,;:!?)]}»",
    "minimumUrlLength": 9,
    "cleartextOfficialDomains": [
      "trenitalia.com",
      "trenitalia.it",
      "viaggiatreno.it",
      "fsitaliane.it",
      "rfi.it",
      "fsnews.it"
    ]
  },
  "rss": {
    "maximumItems": 300,
    "maximumText": 4000
  },
  "strikes": {
    "railWordsPattern": "\\b(ferroviari[oae]?|ferrovi[ae]|treni|treno|fs|trenitalia|italo|trenord|rfi)\\b",
    "titleLength": 300,
    "descriptionLength": 2000,
    "upcomingShown": 6,
    "undatedRecentDays": 14,
    "startLabelPattern": "(inizio|dal|dalle|a partire)\\W*$",
    "endLabelPattern": "(fine|al|alle|termine)\\W*$",
    "labelWindow": 24,
    "inferNextYearMonthsBack": 3
  },
  "months": [
    "gennaio",
    "febbraio",
    "marzo",
    "aprile",
    "maggio",
    "giugno",
    "luglio",
    "agosto",
    "settembre",
    "ottobre",
    "novembre",
    "dicembre"
  ],
  "trenitalia": {
    "maximumItems": 300,
    "titleLength": 300,
    "descriptionLength": 6000,
    "linkLength": 500,
    "maximumTrainTags": 200,
    "trainTagPattern": "[1-9][0-9]{0,5}"
  },
  "trenord": {
    "maximumLines": 300,
    "maximumNewsPerLine": 100,
    "textLength": 4000,
    "titleLength": 160,
    "lineCodeLength": 16,
    "lineCodePattern": "[A-Za-z0-9_-]{1,16}",
    "lineDescriptionLength": 200,
    "operationalPattern": "scioper|soppress|ritard|lavori|variazion|sostitui|sostitutiv|interruz|interrott|circolazion|sospes|cancellat|limitazion|guast|deviat|modific|autobus|servizi[oa]? (di )?bus|corse (di |con )?bus|\\bbus (tra|fra)\\b",
    "stationTokenSeparators": [
      "-",
      "/",
      "–"
    ],
    "minimumTokenLength": 2,
    "hubLineCount": 8,
    "networkWideMinimumLines": 3,
    "area": {
      "minimumLatitude": 44.85,
      "maximumLatitude": 46.65,
      "minimumLongitude": 8.35,
      "maximumLongitude": 10.9
    },
    "gtfsStationPrefix": "gtfs:lombardia-trenord-gtfs:"
  },
  "routeWorks": {
    "maximumRoutes": 8,
    "minimumNameLength": 3,
    "worksPattern": "\\b(lavori|lavoro|interruzion[ei]|interrott[aoie]|sospes[aoie]|sospension[ei]|cantier[ei]|manutenzion[ei]|potenziament[oi]|sostitutiv[aoie])\\b",
    "linePattern": "\\b(?:[Ll]ine[ae]|LINE[AE])\\s+(?:(?:ferroviari[ae]|FERROVIARI[AE])\\s+)?(\\p{Lu}[\\p{L}'’.]*(?:(?:\\s+(?:di|de|del|della|sul|in))?\\s+\\p{Lu}[\\p{L}'’.]*)*)\\s*[-–—]\\s*(\\p{Lu}[\\p{L}'’.]*(?:(?:\\s+(?:di|de|del|della|sul|in))?\\s+\\p{Lu}[\\p{L}'’.]*)*)",
    "commonWords": [
      "ora",
      "tra",
      "via",
      "per",
      "con",
      "piano",
      "campo",
      "ponte",
      "porto",
      "monte",
      "borgo",
      "villa",
      "valle",
      "colle",
      "lago",
      "mare",
      "bivio",
      "scalo",
      "centro",
      "centrale",
      "linea",
      "stazione",
      "nord",
      "sud",
      "est",
      "ovest",
      "torre",
      "castello",
      "croce",
      "marina",
      "lido",
      "porta",
      "pieve",
      "sole",
      "rete",
      "fiume"
    ]
  },
  "display": {
    "networkCollapsed": 6,
    "bodyCollapsedLines": 3,
    "bodyCollapsedCharacters": 180,
    "maximumLineCodes": 6,
    "worksCollapsed": 3
  },
  "trainNotices": {
    "maximumNotes": 500,
    "textLength": 1000,
    "maximumTrains": 20,
    "maximumCachedTrains": 32
  }
}
