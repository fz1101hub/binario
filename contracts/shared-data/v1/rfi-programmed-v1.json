  "departuresBoard": "Partenze",
  "arrivalsBoard": "Arrivi",
  "accept": "text/html,application/xhtml+xml",
  "connectTimeoutSeconds": 12,
  "readTimeoutSeconds": 25,
  "totalTimeoutSeconds": 10,
  "maximumBytes": 2097152,
  "pageTimeToLiveSeconds": 1800,
  "maximumPages": 3,
  "timetableTimeToLiveSeconds": 21600,
  "maximumTimetables": 16,
  "maximumSupplementalTimetables": 8,
  "maximumRouteServices": 24,
  "boardMinimumIntervalSeconds": 2,
