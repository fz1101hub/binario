          "name": "Milano Centrale",
          "delayMinutes": 0,
          "arrived": true,
          "verified": true,
          "skipped": false
        },
        {
          "name": "Pavia",
          "delayMinutes": 59,
          "arrived": true,
          "verified": true,
          "skipped": false
        }
      ],
      "cancelled": false,
      "demonstration": false,
      "serviceVerified": true,
      "expected": null
    },
    {
