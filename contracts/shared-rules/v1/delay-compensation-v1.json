{
  "schema": "binario-shared-rules-v1",
  "description": "When the train detail states the compensation of Regulation (EU) 2021/782, art. 19 (data/DelayCompensation.kt): only on the actual arrival a source verified at the last stop shown, at least 60 minutes late (25 % of the ticket price), 50 % from 120 minutes; never on demonstration data, a cancelled train, a stop it skipped or a stop without an actual arrival. A stop's «verified» null means the run's own verification. The thresholds are contracts/shared-data/v1/delay-compensation-v1.json.",
  "readers": [
    "app/src/test/java/it/binario/app/data/DelayCompensationContractTest.kt",
    "ios/BinarioKit/Tests/BinarioKitTests/ExtrasContractTests.swift"
  ],
