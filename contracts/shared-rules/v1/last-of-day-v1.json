          "terminus": "Brescia"
        }
      },
      "now": "2026-11-24T22:00",
      "expected": null
    },
    {
      "name": "a last departure leaving this minute is still to leave",
      "day": {
        "lastByTerminus": [
          {
            "departure": "2026-11-24T21:40",
            "publicNumber": "02153",
            "terminus": "Bergamo"
          },
          {
            "departure": "2026-11-24T22:10",
            "publicNumber": "RE_11 - 2671",
            "terminus": "Brescia"
          }
        ],
        "firstNextDay": {
          "departure": "2026-11-25T05:42",
          "publicNumber": "2601",
          "terminus": "Brescia"
        }
      },
      "now": "2026-11-24T22:10",
      "expected": null
    },
    {
      "name": "a day without departures gives the first of tomorrow",
      "day": {
        "lastByTerminus": [],
        "firstNextDay": {
          "departure": "2026-11-25T05:42",
          "publicNumber": "2601",
          "terminus": "Brescia"
        }
      },
      "now": "2026-11-24T10:00",
      "expected": "2026-11-25T05:42"
    },
    {
      "name": "no train tomorrow: nothing to say",
      "day": {
        "lastByTerminus": [
          {
            "departure": "2026-11-24T21:40",
            "publicNumber": "2153",
            "terminus": "Bergamo"
          }
        ],
        "firstNextDay": null
      },
      "now": "2026-11-24T23:00",
      "expected": null
    },
    {
      "name": "without the timetable of the day nothing is said",
      "day": null,
      "now": "2026-11-24T23:00",
      "expected": null
    }
  ],
  "markedDay": [
    {
      "name": "a board following the current time marks today",
      "today": "2026-11-24",
      "followsCurrentTime": true,
      "searchDate": "2026-11-25",
      "expected": "2026-11-24"
    },
    {
      "name": "a search of today marks today",
      "today": "2026-11-24",
      "followsCurrentTime": false,
      "searchDate": "2026-11-24",
      "expected": "2026-11-24"
    },
    {
      "name": "a search planned for tomorrow marks nothing",
