    {
      "name": "a train of the day is still to leave",
      "day": {
        "lastByTerminus": [
          {
            "departure": "2026-11-24T21:40",
            "publicNumber": "02153",
            "terminus": "Bergamo"
          },
          {
            "departure": "2026-11-24T22:10",
            "publicNumber": "RE_11 - 2671",
