{
  "schema": "binario-shared-rules-v1",
  "description": "Weather at the destination (data/weather/DestinationWeatherTarget.kt, OpenMeteoForecastAdapter.kt, DestinationWeatherSection.kt): the station and day a train detail's forecast is for (the last stop shown, on its arrival date: the next day when its arrival clock time is earlier than the departure), the coordinates sent (two decimals, half away from zero), the request, the daily forecast read from an Open-Meteo answer (out-of-range values dropped, at most 16 days; a body without daily dates is unreadable) and the WMO codes that have their own text. The source is contracts/shared-data/v1/destination-weather-v1.json.",
  "readers": [
    "app/src/test/java/it/binario/app/data/weather/DestinationWeatherContractTest.kt",
    "ios/BinarioKit/Tests/BinarioKitTests/ExtrasContractTests.swift"
  ],
  "targets": [
    {
      "name": "arrival on the day of the departure",
      "lastStop": "Milano Centrale",
      "lastScheduled": "12:05",
      "destination": "Milano Centrale",
      "departureDate": "2026-11-23",
      "departure": "10:20",
      "today": "2026-11-23",
      "expected": {
        "station": "Milano Centrale",
        "date": "2026-11-23"
      }
    },
    {
      "name": "an arrival clock time before the departure is after midnight",
      "lastStop": "Palermo Centrale",
      "lastScheduled": "00:40",
      "destination": "Palermo Centrale",
      "departureDate": "2026-11-23",
      "departure": "23:10",
      "today": "2026-11-23",
      "expected": {
        "station": "Palermo Centrale",
        "date": "2026-11-24"
      }
    },
    {
      "name": "a night train leaving yesterday",
      "lastStop": "Siracusa",
      "lastScheduled": "09:30",
      "destination": "Siracusa",
      "departureDate": "2026-11-22",
      "departure": "21:00",
      "today": "2026-11-23",
      "expected": {
        "station": "Siracusa",
        "date": "2026-11-23"
      }
    },
    {
      "name": "without a departure date, today",
      "lastStop": "Pavia",
      "lastScheduled": "08:40",
      "destination": "Pavia",
      "departureDate": null,
      "departure": "08:05",
      "today": "2026-11-23",
      "expected": {
        "station": "Pavia",
        "date": "2026-11-23"
      }
    },
    {
      "name": "a last stop without a clock time keeps the departure day",
      "lastStop": "Pavia",
      "lastScheduled": null,
      "destination": "Pavia",
      "departureDate": "2026-11-23",
      "departure": "23:50",
      "today": "2026-11-23",
      "expected": {
        "station": "Pavia",
        "date": "2026-11-23"
      }
    },
    {
      "name": "without stops, the destination",
      "lastStop": null,
      "lastScheduled": null,
      "destination": "Genova Piazza Principe",
      "departureDate": "2026-11-23",
      "departure": "10:00",
      "today": "2026-11-23",
      "expected": {
        "station": "Genova Piazza Principe",
        "date": "2026-11-23"
      }
    },
    {
      "name": "no station at all",
      "lastStop": " ",
      "lastScheduled": "12:00",
      "destination": " ",
      "departureDate": "2026-11-23",
      "departure": "10:00",
      "today": "2026-11-23",
      "expected": null
    }
  ],
