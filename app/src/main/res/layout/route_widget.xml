<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/widget_open_app"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_column_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">

        <TextView android:layout_width="54dp" android:layout_height="wrap_content" android:text="@string/widget_column_time" android:textColor="@color/widget_on_surface_muted" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_column_destination_train" android:textColor="@color/widget_on_surface_muted" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/widget_column_platform" android:textColor="@color/widget_on_surface_muted" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/widget_column_status" android:textColor="@color/widget_on_surface_muted" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_row_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:orientation="horizontal" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_0" android:layout_width="54dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_destination_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="@color/widget_on_surface" android:textSize="13sp" />
        <TextView android:id="@+id/widget_platform_0" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_0" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_1" android:layout_width="54dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_destination_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="@color/widget_on_surface" android:textSize="13sp" />
        <TextView android:id="@+id/widget_platform_1" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_1" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_2" android:layout_width="54dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_destination_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="@color/widget_on_surface" android:textSize="13sp" />
        <TextView android:id="@+id/widget_platform_2" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_2" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_3" android:layout_width="54dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_destination_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="@color/widget_on_surface" android:textSize="13sp" />
        <TextView android:id="@+id/widget_platform_3" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_3" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_4" android:layout_width="54dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_destination_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="@color/widget_on_surface" android:textSize="13sp" />
        <TextView android:id="@+id/widget_platform_4" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_4" android:layout_width="48dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView android:id="@+id/widget_previous_page" style="@style/Binario.Widget.Action" android:contentDescription="@string/widget_previous_page" android:text="@string/widget_previous_symbol" />
        <TextView android:id="@+id/widget_direction" style="@style/Binario.Widget.Action" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="@string/widget_switch_direction" android:text="@string/widget_default_direction" />
        <TextView android:id="@+id/widget_next_page" style="@style/Binario.Widget.Action" android:contentDescription="@string/widget_next_page" android:text="@string/widget_next_symbol" />
        <TextView android:id="@+id/widget_refresh" style="@style/Binario.Widget.Action" android:contentDescription="@string/widget_refresh" android:text="@string/widget_refresh_label" />
    </LinearLayout>
</LinearLayout>
