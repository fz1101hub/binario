<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/widget_open_app"
        android:ellipsize="end"
        android:focusable="true"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/widget_on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_on_surface_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_column_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/widget_header"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp">

        <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="@string/widget_column_time" android:textColor="@color/widget_header_text" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_column_destination_train" android:textColor="@color/widget_header_text" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="42dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/widget_column_platform" android:textColor="@color/widget_header_text" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/widget_column_status" android:textColor="@color/widget_header_text" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_row_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="6dp" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_0" android:layout_width="50dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_destination_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_train_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface_muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_platform_0" android:layout_width="42dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_0" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="6dp" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_1" android:layout_width="50dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_destination_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_train_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface_muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_platform_1" android:layout_width="42dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_1" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="6dp" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_2" android:layout_width="50dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_destination_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_train_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface_muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_platform_2" android:layout_width="42dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_2" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="6dp" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_3" android:layout_width="50dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_destination_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_train_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface_muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_platform_3" android:layout_width="42dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_3" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:background="@drawable/widget_row_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="6dp" android:paddingVertical="5dp">
        <TextView android:id="@+id/widget_time_4" android:layout_width="50dp" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="@color/widget_on_surface" android:textSize="15sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_destination_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_train_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="@color/widget_on_surface_muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/widget_platform_4" android:layout_width="42dp" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/widget_on_surface" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_status_4" android:layout_width="44dp" android:layout_height="wrap_content" android:gravity="end" android:maxLines="1" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_actions_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_previous_page" style="@style/Binario.Widget.Action" android:contentDescription="@string/widget_previous_page" android:text="@string/widget_previous_symbol" />
        <TextView android:id="@+id/widget_direction" style="@style/Binario.Widget.Action" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="@string/widget_switch_direction" android:text="@string/widget_default_direction" />
        <TextView android:id="@+id/widget_next_page" style="@style/Binario.Widget.Action" android:contentDescription="@string/widget_next_page" android:text="@string/widget_next_symbol" />
        <TextView android:id="@+id/widget_refresh" style="@style/Binario.Widget.Action" android:contentDescription="@string/widget_refresh" android:text="@string/widget_refresh_symbol" />
    </LinearLayout>
</LinearLayout>
