<?xml version="1.0" encoding="utf-8"?>
<!--
    Advertised to the paired phone through the Wear Data Layer: this watch app decodes the optional
    reliability pair of the snapshot contract v1 (contracts/wear-snapshot/v1/README.md), so the phone
    adds it only while every connected watch advertises this capability. Play services looks the array
    up by name, so it is kept for the resource shrinker and for lint's unused-resource check.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@array/android_wear_capabilities">
    <string-array name="android_wear_capabilities" translatable="false">
        <item>binario_wear_reliability_v1</item>
    </string-array>
</resources>
