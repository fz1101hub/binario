<?xml version="1.0" encoding="utf-8"?>
<!--
    Advertised to the paired phone through the Wear Data Layer: this watch app decodes the optional
    reliability pair and the optional vehicle of the snapshot contract v1 (contracts/wear-snapshot/v1/README.md),
    and falls back to the programmed times when the live values expire, so the phone adds each field, or the
    programmed lifetime, only while every connected watch advertises its capability. Play services looks the
    array up by name, so it is kept for the resource shrinker and for lint's unused-resource check.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:keep="@array/android_wear_capabilities">
    <string-array name="android_wear_capabilities" translatable="false">
        <item>binario_wear_reliability_v1</item>
        <item>binario_wear_vehicle_v1</item>
        <item>binario_wear_programmed_fallback_v1</item>
    </string-array>
</resources>
