{
  "name": "binario-companion-native",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate:brand-assets": "python3 scripts/generate-binario-brand-assets.py",
    "check": "tsc --noEmit && pnpm verify:branding",
    "test": "vitest run && pnpm verify:branding",
    "prebuild": "pnpm generate:brand-assets && expo prebuild --platform android",
    "verify:branding": "node scripts/verify-branding.mjs",
    "verify:managed-config": "node scripts/verify-managed-config.mjs",
    "verify:dependency-audit": "node scripts/verify-dependency-audit.mjs",
    "verify:release-inputs": "node scripts/verify-release-inputs.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/native": "^7.1.25",
    "expo": "~54.0.29",
    "expo-constants": "~18.0.12",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-haptics": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.19",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/config-plugins": "54.0.5",
    "@types/react": "~19.1.17",
    "typescript": "~5.9.3",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@10.34.5"
}
