    "watch.hint.reloadCache": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non richiede dati live e ricarica solo l’ultimo snapshot disponibile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not require live data and reloads only the latest available snapshot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt keine Live-Daten und lädt nur den letzten verfügbaren Snapshot erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne nécessite pas de données en direct et recharge uniquement le dernier instantané disponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No requiere datos en directo y recarga solo la última instantánea disponible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتطلب بيانات مباشرة، ويعيد تحميل آخر لقطة متاحة فقط."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव डेटा की ज़रूरत नहीं; केवल अंतिम उपलब्ध स्नैपशॉट दोबारा लोड करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak memerlukan data langsung dan hanya memuat ulang snapshot terakhir yang tersedia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブデータは不要で、最新のスナップショットのみを再読み込みします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 데이터가 필요 없으며 마지막 스냅샷만 다시 불러옵니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "တိုက်ရိုက်ဒေတာ မလိုအပ်ဘဲ နောက်ဆုံး snapshot ကိုသာ ပြန်ဖွင့်သည်။"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não requer dados ao vivo e recarrega apenas o último instantâneo disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не требует живых данных и перезагружает только последний доступный снимок."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องใช้ข้อมูลสด และโหลดเฉพาะสแนปช็อตล่าสุดที่มีอยู่ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı veri gerektirmez ve yalnızca mevcut son anlık görüntüyü yeniden yükler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần dữ liệu trực tiếp, chỉ tải lại ảnh chụp mới nhất hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需实时数据，只重新载入最近一次可用的快照。"
          }
        }
      }
    },
    "watch.intent.refresh.description": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rileggere lo snapshot ferroviario già disponibile sul dispositivo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rereads the rail snapshot already available on the device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest den bereits auf dem Gerät verfügbaren Bahn-Snapshot erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relit l’instantané ferroviaire déjà disponible sur l’appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a leer la instantánea ferroviaria ya disponible en el dispositivo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد قراءة لقطة القطارات المتوفرة مسبقًا على الجهاز."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर पहले से उपलब्ध रेल स्नैपशॉट दोबारा पढ़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membaca ulang snapshot kereta yang sudah ada di perangkat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスにある鉄道スナップショットを再読み込みします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 이미 있는 철도 스냅샷을 다시 읽습니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "စက်ပေါ်တွင် ရှိပြီးသား ရထား snapshot ကို ပြန်ဖတ်သည်။"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relê o instantâneo ferroviário já disponível no dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перечитывает железнодорожный снимок, уже сохранённый на устройстве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านสแนปช็อตข้อมูลรถไฟที่มีอยู่แล้วบนอุปกรณ์อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazda zaten bulunan demiryolu anlık görüntüsünü yeniden okur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc lại ảnh chụp dữ liệu đường sắt đã có trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取设备上已有的铁路快照。"
          }
        }
      }
    },
