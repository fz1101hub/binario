    "watch.widget.description": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la prossima corsa e lo stato del dato disponibile."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the next service and available data status."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die nächste Verbindung und den verfügbaren Datenstatus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le prochain service et l’état des données disponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el próximo servicio y el estado de los datos disponibles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض الرحلة التالية وحالة البيانات المتاحة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली सेवा और उपलब्ध डेटा की स्थिति दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan layanan berikutnya dan status data yang tersedia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の列車と利用可能なデータの状態を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 열차와 사용 가능한 데이터 상태를 표시합니다."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "နောက်ထပ် ခရီးစဉ်နှင့် ရရှိနိုင်သော ဒေတာ အခြေအနေကို ပြသည်။"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o próximo serviço e o status dos dados disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает ближайший рейс и состояние доступных данных."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเที่ยวรถถัดไปและสถานะของข้อมูลที่มี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki seferi ve mevcut verilerin durumunu gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị chuyến tiếp theo và trạng thái dữ liệu hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示下一班车次和可用数据的状态。"
          }
        }
