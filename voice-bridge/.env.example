# Binario Voice Bridge — variabili d'ambiente
# Copia in .env (mai committato) e valorizza. In produzione il server rifiuta
# di avviarsi se JWT_SECRET, VITE_APP_ID o OAUTH_SERVER_URL mancano.

# Porta di ascolto. In produzione è vincolante (nessun fallback automatico).
PORT=3000
NODE_ENV=production
# Hop di reverse proxy fidati (default: 1 in produzione, 0 altrimenti).
TRUST_PROXY=1

# Sessione dashboard: segreto HS256, almeno 32 caratteri casuali.
JWT_SECRET=
# Identificativo dell'app presso il portale OAuth (verificato in ogni sessione).
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# MySQL (drizzle). Senza DATABASE_URL le funzioni personali rispondono "archivio non disponibile".
DATABASE_URL=mysql://user:password@host:3306/binario

# Integrazione Alexa: fail-closed finché tutte le variabili non sono presenti.
ALEXA_SKILL_ID=
ALEXA_OAUTH_CLIENT_ID=
ALEXA_OAUTH_CLIENT_SECRET=
# Callback Amazon registrate per l'account linking, separate da virgola, confronto esatto.
ALEXA_OAUTH_REDIRECT_URIS=https://pitangui.amazon.com/api/skill/link/XXXX,https://layla.amazon.com/api/skill/link/XXXX,https://alexa.amazon.co.jp/api/skill/link/XXXX
# Pepper per i digest dei code/refresh token e per la derivazione della chiave dei token vocali.
VOICE_TOKEN_PEPPER=

# Storage proxy del template (opzionale, non usato dall'app).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
